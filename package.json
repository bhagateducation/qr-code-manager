{
  "name": "qr-code-manager-saas",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && node scripts/build-next.mjs",
    "postinstall": "node scripts/ensure-prisma-executable.mjs",
    "start": "next start",
    "lint": "tsc --noEmit --incremental false",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "tsx --test tests/*.test.ts && tsx --conditions react-server --test tests/*.server-test.ts",
    "db:migrate": "prisma migrate deploy",
    "release": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.9.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0.0 <27"
  }
}
