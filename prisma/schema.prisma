generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  plan        String       @default("free")
  paidUntil   DateTime?
  suspended   Boolean      @default(false)
  qrSeq       Int          @default(0) // last QR number handed out in this workspace
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  systems     System[]
  qrCodes     QRCode[]
  folders     Folder[]
  webhooks    Webhook[]
  tags        Tag[]
  automations Automation[]
  campaigns   Campaign[]
  integrations Integration[]
  apiKeys     ApiKey[]
  invitations Invitation[]
  payments    Payment[]
  audits      AuditLog[]

  @@map("workspaces")
}

model User {
  id           String     @id @default(uuid())
  workspaceId  String
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("owner") // workspace role, not platform administrator
  platformAdmin Boolean   @default(false)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  backupCodes  Json?
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([workspaceId])
  @@unique([emailVerificationTokenHash])
  @@unique([passwordResetTokenHash])
  @@map("users")
}

model System {
  id           String        @id @default(uuid())
  workspaceId  String
  name         String
  icon         String        @default("layers")
  description  String?
  statuses     Json?         // JSON array of custom status pipeline
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields       CustomField[]
  records      Record[]

  @@index([workspaceId])
  @@map("systems")
}

model CustomField {
  id         String    @id @default(uuid())
  systemId   String
  key        String
  label      String
  type       String    // text, number, date, url, image, status, json, phone, currency, etc.
  isRequired Boolean   @default(false)
  isUnique   Boolean   @default(false)
  options    Json?     // select options, min/max, format
  order      Int       @default(0)

  system     System    @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@unique([systemId, key])
  @@map("custom_fields")
}

model Record {
  id         String     @id @default(uuid())
  systemId   String
  publicToken String    @unique @default(uuid())
  isPublic   Boolean    @default(false)
  title      String
  data       Json       // Key-value store of custom field values
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  system     System     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  qrCodes    QRCode[]

  @@index([systemId])
  @@map("records")
}

model QRCode {
  id           String     @id @default(uuid())
  workspaceId  String
  recordId     String?
  campaignId   String?
  shortCode    String     @unique // e.g. "acme-qr-928"
  title        String
  type         String     @default("dynamic_url") // dynamic_url, vcard, menu, wifi, product, etc.
  targetUrl    String
  routingRules Json?      // device, schedule, or geo redirection
  styling      Json?      // fgColor, bgColor, pattern, corner, logo, frame
  scanCount    Int        @default(0)
  isActive     Boolean    @default(true)
  folderId     String?
  number       Int        @default(0) // human-friendly number, unique per workspace
  deletedAt    DateTime?  // set while the code sits in the trash
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record       Record?    @relation(fields: [recordId], references: [id], onDelete: SetNull)
  campaign     Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  folder       Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  scanLogs     ScanLog[]
  tags         QRCodeTag[]

  @@index([workspaceId])
  @@index([recordId])
  @@index([campaignId])
  @@index([shortCode])
  @@index([folderId])
  @@unique([workspaceId, number])
  @@index([workspaceId, deletedAt, createdAt])
  @@map("qr_codes")
}

model ScanLog {
  id        String   @id @default(uuid())
  qrCodeId  String
  ipHash    String?
  country   String?  @default("Unknown")
  city      String?  @default("Unknown")
  device    String?  @default("Mobile")
  os        String?  @default("Unknown")
  browser   String?  @default("Unknown")
  scannedAt DateTime @default(now())

  qrCode    QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("scan_logs")
}

model Webhook {
  id          String     @id @default(uuid())
  workspaceId String
  url         String
  secret      String
  events      Json       // array of events: ["scan.created", "record.updated"]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  eventType   String
  payload     Json
  status      String   @default("pending")
  responseCode Int?
  attempts    Int      @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  @@index([webhookId, createdAt])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#5B43D6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  qrCodes     QRCodeTag[]
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

model Automation {
  id          String   @id @default(uuid())
  workspaceId String
  name       String
  kind       String   @default("workflow")
  config     Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, kind])
  @@map("automations")
}

model Campaign {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  qrCodes     QRCode[]
  @@index([workspaceId, status])
  @@map("campaigns")
}

// A folder (category). Folders nest, e.g. Book > Chapter; "kind" marks the ones made by the Book QR tool.
model Folder {
  id          String    @id @default(uuid())
  workspaceId String
  parentId    String?
  name        String
  kind        String    @default("folder") // folder, book, chapter
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]  @relation("FolderTree")
  qrCodes     QRCode[]

  @@index([workspaceId, parentId])
  @@map("folders")
}

model QRCodeTag {
  qrCodeId String
  tagId    String
  qrCode   QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([qrCodeId, tagId])
  @@index([tagId])
  @@map("qr_code_tags")
}

model Integration {
  id          String   @id @default(uuid())
  workspaceId String
  provider    String
  name        String
  config      Json?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, provider])
  @@map("integrations")
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  label       String
  prefix      String
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, revokedAt])
  @@map("api_keys")
}

model Invitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        String    @default("editor")
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model Payment {
  id String @id @default(uuid())
  workspaceId String
  orderId String @unique
  paymentId String? @unique
  plan String
  amount Int
  currency String @default("INR")
  status String @default("created")
  createdAt DateTime @default(now())
  paidAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}

model AuditLog {
  id String @id @default(uuid())
  workspaceId String
  actorId String
  action String
  entityId String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}
